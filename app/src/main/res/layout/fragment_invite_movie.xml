<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:padding="20dp"
    tools:context=".ui.matchingSession.creation.confirmation.banners.InviteConfirmMovieFragment"
    android:clipChildren="false"
    android:clipToPadding="false"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:contentDescription="@string/card_image_description"
            android:scaleType="centerCrop"
            android:src="@drawable/movie_image_invite"
            />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/card_image_description"
            android:rotation="3"
            android:shadowColor="@color/food_match_base"
            android:shadowDx="-12"
            android:shadowDy="8"
            android:shadowRadius="10"
            android:text="@string/match_movie_text"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="40sp" />


    </LinearLayout>

</FrameLayout>