<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activitiesDashboard.ActivitiesDashboardFragment">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0B101A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <ImageView
                android:id="@+id/app_logo"
                android:layout_width="24dp"
                android:layout_height="26dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_activity_selection" />

            <TextView
                android:id="@+id/app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="Match IT"
                android:textColor="#ffffff"
                android:textSize="23sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />


            <ImageButton
                android:id="@+id/btn_overflow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:contentDescription="Menu"
                android:padding="4dp"
                android:src="@drawable/ic_more_vert_24"
                android:tint="#ffffff" />

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="700dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/profile_picture_view"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="17dp"
                    android:contentDescription="@string/dummy_username"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.12"
                    app:shapeAppearanceOverlay="@style/Circular"
                    tools:layout_editor_absoluteX="0dp" />


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dashboard_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_welcome_title"
                        android:textAlignment="center"
                        android:textColor="#EB1F1F1F"
                        android:textSize="32sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dashboard_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:text="@string/dashboard_welcome_subtitle"
                    android:textAlignment="center"
                    android:textColor="#4E4C4C"
                    android:textSize="22sp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">


                            <androidx.cardview.widget.CardView
                                android:id="@+id/movie_match_activity_back"
                                android:layout_width="match_parent"
                                android:layout_height="185dp"
                                android:layout_marginVertical="15dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                app:cardBackgroundColor="#2A2C8A"
                                app:cardCornerRadius="15dp"
                                app:cardElevation="2dp">

                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="15dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:lineSpacingMultiplier="0.89"
                                        android:text="@string/movie_card_title"
                                        android:textColor="@color/white"
                                        android:textSize="22sp"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintHorizontal_bias="0.496"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"
                                        app:layout_constraintVertical_bias="0.00" />
                                </androidx.constraintlayout.widget.ConstraintLayout>

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:layout_gravity="bottom|center_horizontal"
                                    android:background="@android:color/white">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/start_movies_session_btn"
                                        android:layout_width="match_parent"
                                        android:layout_height="71dp"
                                        android:layout_gravity="center"
                                        android:backgroundTint="@color/black"
                                        android:text="Invite"
                                        android:textSize="20sp"
                                        app:cornerRadius="10dp" />

                                </FrameLayout>

                            </androidx.cardview.widget.CardView>


                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/movie_match_activity"
                                android:layout_width="match_parent"
                                android:layout_height="200dp"

                                android:layout_marginVertical="15dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@android:color/transparent"
                                android:foreground="?attr/selectableItemBackground"
                                android:background="@drawable/bg_restaurant_gradient"
                                app:cardCornerRadius="15dp"
                                app:cardElevation="2dp">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_movie_gradient"/>


                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">

                                    <ImageView
                                        android:layout_width="75dp"
                                        android:layout_height="75dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_movie2"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintHorizontal_bias="0.496"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"

                                        app:layout_constraintVertical_bias="0.384"
                                        app:tint="@color/white" />
                                </androidx.constraintlayout.widget.ConstraintLayout>

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:layout_gravity="bottom|center_horizontal"
                                    android:background="@android:color/white">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"

                                        android:layout_gravity="center"
                                        android:text="@string/movie_activity_title"

                                        android:textColor="@color/black"
                                        android:textSize="20sp" />

                                </FrameLayout>

                            </com.google.android.material.card.MaterialCardView>

                        </FrameLayout>

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="7dp">


                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/restaurant_match_activity"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"

                            android:layout_marginVertical="15dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@android:color/transparent"
                            android:foreground="?attr/selectableItemBackground"
                            android:background="@drawable/bg_restaurant_gradient"
                            app:cardCornerRadius="15dp"
                            app:cardElevation="2dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_restaurant_gradient"/>


                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:layout_width="85dp"
                                    android:layout_height="75dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_restaurant"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintHorizontal_bias="0.496"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"

                                    app:layout_constraintVertical_bias="0.384"
                                    app:tint="@color/white" />
                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@android:color/white">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:layout_gravity="center"
                                    android:text="@string/restaurant_activity_title"

                                    android:textColor="@color/black"
                                    android:textSize="20sp" />

                            </FrameLayout>


                        </com.google.android.material.card.MaterialCardView>


                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>