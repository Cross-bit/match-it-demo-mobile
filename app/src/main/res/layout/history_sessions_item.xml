<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="120dp"
    android:padding="12dp"

    android:layout_marginHorizontal="3dp"
    android:layout_marginVertical="2dp"

    app:cardBackgroundColor="#00CC1818"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"

    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"

    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:paddingTop="18dp"
        android:orientation="vertical"
        android:gravity="center_vertical">
    <TextView
        android:id="@+id/sesTypeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:background="#455AFF"
        android:text="MOVIE"
        android:paddingHorizontal="5dp"

        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/thumbnail"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.195"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/sessionTypeImg"
            android:layout_width="60dp"
            android:layout_height="60dp"

            android:adjustViewBounds="true"
            app:contentPadding="15dp"
            app:layout_constraintHorizontal_bias="0.5"
            app:shapeAppearanceOverlay="@style/Circular"

            android:src="@drawable/ic_movie2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/sessionDatetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="14. 11. 2025"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/thumbnail"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.195" />

            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="6dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatar1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/tribe_icon"
                    app:shapeAppearanceOverlay="@style/Circular"
                    android:background="@color/white"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatar2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="18dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/tribe_icon"
                    app:shapeAppearanceOverlay="@style/Circular"
                    android:background="@color/white"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatar3"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="36dp"
                    android:src="@drawable/tribe_icon"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/Circular"
                    android:background="@color/white"/>

                <TextView
                    android:id="@+id/avatarMore"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="36dp"
                    android:gravity="center"
                    android:text="+2"
                    android:textSize="12sp"
                    android:textColor="@color/white"

                    android:background="@drawable/bg_circle_more"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

