<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.sessionHistoryChats.SessionHistoryChatsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/session_history_panel_title"
            android:textColor="#222222"
            android:textSize="27sp"
            android:textStyle="bold"
            android:layout_marginStart="20dp"
            android:layout_marginTop="7dp"
            android:paddingBottom="7dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#CCCCCC"
            app:layout_constraintTop_toBottomOf="@id/title" />


        <FrameLayout
            android:id="@+id/history_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintBottom_toBottomOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_sessions_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="2dp"
            android:paddingTop="6dp"


            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title" />

            <ProgressBar
                android:id="@+id/sessions_load_progress_bar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                />

            <TextView
                android:id="@+id/no_data_message"
                android:layout_gravity="center"
                android:layout_width="310dp"
                android:textAlignment="center"
                android:layout_height="wrap_content"
                android:text="@string/no_history_data_text"
                android:textColor="#222222"
                android:textSize="18sp"
                android:visibility="gone"
                />

            <TextView
                android:id="@+id/error_message"
                android:layout_gravity="center"
                android:layout_width="310dp"
                android:textAlignment="center"
                android:layout_height="wrap_content"
                android:text="@string/data_load_error_come_back_later"
                android:textColor="#222222"
                android:textSize="18sp"
                android:visibility="gone"
                />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>