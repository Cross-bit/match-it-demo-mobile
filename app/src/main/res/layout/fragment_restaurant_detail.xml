<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.matchingSession.matching.cards.restaurants.RestaurantDetailFragment"
    android:clipChildren="false"
    android:clipToPadding="false"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/restaurant_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        android:minHeight="1000dp"
        app:behavior_peekHeight="700dp"
        app:behavior_hideable="true"
        >


        <View
            android:id="@+id/drag_handle"
            android:layout_width="45dp"
            android:layout_height="4dp"
            android:background="@drawable/drag_handle_background"
            android:layout_marginTop="20dp"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:elevation="20dp"
            />

        <androidx.cardview.widget.CardView
            android:layout_marginTop="5dp"
            android:transitionName="card_transition_@+id/card_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="30dp"
            app:cardElevation="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"

            >

            <androidx.core.widget.NestedScrollView
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@id/drag_handle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                >

            <LinearLayout
                android:minHeight="1000dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="10dp"
                >

                <!-- Gallery -->

                <FrameLayout
                    android:id="@+id/frameLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"

                    app:layout_constraintBottom_toTopOf="@+id/movie_info"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"

                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/carousel_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="5dp"
                    >

                    <TextView
                        android:id="@+id/card_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:layout_weight="1"
                        android:paddingTop="6dp"
                        android:text="Avatar (2009)"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:orientation="vertical"
                        android:paddingTop="7dp"
                        android:paddingEnd="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical|end"
                            android:orientation="horizontal"

                            >

                            <TextView
                                android:id="@+id/google_rating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"

                                android:layout_marginBottom="2dp"
                                android:text="2.4"
                                android:textSize="25sp" />

                            <ImageView
                                android:layout_width="27dp"
                                android:layout_height="27dp"
                                android:src="@drawable/ic_star_rate"></ImageView>


                        </LinearLayout>

                        <TextView
                            android:id="@+id/google_review_note"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"

                            android:layout_marginBottom="2dp"
                            android:text="(from google)"
                            android:textSize="10sp"
                            android:textStyle="bold" />


                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="10dp"
                    >

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/type_chips_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleLine="false"
                        app:chipSpacingVertical="-7dp"

                        />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/features_chips_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-8dp"
                        app:singleLine="false"
                        android:visibility="gone"
                        />
                </LinearLayout>

                <!-- Opening Hours -->
                <LinearLayout
                    android:id="@+id/opening_hours_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:padding="12dp"

                    >

                    <!-- TODAY OPENING -->
                    <LinearLayout
                        android:id="@+id/opening_hours_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        >

                        <TextView
                            android:id="@+id/opening_hours_today"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dnes 10:00 – 20:00"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            />

                        <ImageView
                            android:id="@+id/opening_hours_arrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_expand_more"
                            />
                    </LinearLayout>

                    <!-- HOURS DETAIL -->
                    <LinearLayout
                        android:id="@+id/opening_hours_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="8dp"
                        />

                </LinearLayout>


                <TextView
                    android:id="@+id/address_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginTop="5dp"
                    android:text="@string/restaurant_address_title_text"
                    android:textColor="@color/app_base_color"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_marginVertical="7dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_location"
                        android:tint="@color/app_base_color"
                        >

                    </ImageView>

                    <TextView
                        android:id="@+id/place_address_text"
                        android:layout_width="match_parent"
                        android:textSize="15sp"
                        android:paddingHorizontal="2dp"
                        android:layout_height="wrap_content"
                    />

                </LinearLayout>

            <com.example.matchit.ui.common.MapTouchWrapper
                    android:layout_width="match_parent"
                    android:layout_height="300dp">
            <com.google.android.gms.maps.MapView
                android:id="@+id/restaurant_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp" />

                </com.example.matchit.ui.common.MapTouchWrapper>

                <TextView
                    android:id="@+id/open_in_maps_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    android:text="@string/open_in_google_maps"
                    android:textColor="@color/app_base_color"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>